{
  "name": "classin-ai-risk-operations-dashboard",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node --max-old-space-size=256 scripts/run-framework.mjs dev",
    "build": "node --max-old-space-size=1536 scripts/run-framework.mjs build",
    "start": "node --max-old-space-size=256 scripts/run-framework.mjs dev",
    "backup": "node scripts/backup-local-db.mjs",
    "snapshot:refresh": "node scripts/generate-snapshot.mjs",
    "eeo:collect": "node --max-old-space-size=256 scripts/eeo-browser-collector.mjs",
    "eeo:bridge": "node --max-old-space-size=128 ../tools/local_capture_server.mjs",
    "eeo:import": "node --max-old-space-size=256 scripts/import-eeo-manual-capture.mjs",
    "typecheck": "node --max-old-space-size=768 node_modules/typescript/bin/tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .eeo-browser-profile",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/migrate-local-db.mjs",
    "dev:vite": "node --max-old-space-size=768 scripts/run-vite.mjs",
    "eeo:prepare": "node --max-old-space-size=256 scripts/prepare-eeo-refresh.mjs",
    "eeo:publish": "node --max-old-space-size=256 scripts/publish-eeo-refresh.mjs",
    "eeo:weekly": "node --max-old-space-size=256 --experimental-strip-types scripts/run-eeo-weekly.mjs",
    "eeo:login": "node --max-old-space-size=256 --experimental-strip-types scripts/run-eeo-weekly.mjs --login",
    "eeo:sync": "node --max-old-space-size=128 --experimental-strip-types scripts/sync-eeo-online.mjs",
    "crm:import": "node --max-old-space-size=256 --experimental-strip-types scripts/import-crm-workbook.mjs",
    "eeo:schedule:status": "powershell.exe -NoProfile -Command \"Get-ScheduledTaskInfo -TaskName 'EEO-Teaching-Risk-Weekly' | Select-Object LastRunTime,LastTaskResult,NextRunTime\"",
    "eeo:schedule": "powershell.exe -NoProfile -NonInteractive -Command \"& ([scriptblock]::Create((Get-Content -LiteralPath 'scripts/install-eeo-schedule.ps1' -Raw))) -ScriptHome (Join-Path (Get-Location) 'scripts')\""
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76",
    "miniflare": "4.20260515.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
